# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/task-manager

# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret

# Port the Express server listens on locally (Render sets this automatically in production)
PORT=5000